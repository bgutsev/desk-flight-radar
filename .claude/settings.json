{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff format . && python -m ruff check ."
          },
          {
            "type": "command",
            "command": "python .claude/log-change.py"
          }
        ]
      }
    ]
  }
}
